# ── .NET ────────────────────────────────────────────────────────────────────
bin/
obj/
*.user
.vs/
*.suo
*.userosscache
*.sln.docstates

# ASP.NET Core user secrets (dotnet user-secrets)
**/secrets.json

# Published output
publish/
out/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Docker secrets (used by docker-compose) ──────────────────────────────────
# .env.example IS committed — it contains only placeholders, no real values
# The real .env is not committed
# (already covered by .env above)

# ── Uploaded user content ────────────────────────────────────────────────────
# Book cover images uploaded at runtime should not be in source control
FossReadsAPI/wwwroot/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Claude Code internal ─────────────────────────────────────────────────────
.claude/worktrees/
